---
interface Item {
  href: string;
  label: string;
}
interface Props {
  heading: string;
  items: Item[];
  emptyText?: string;
}
const { heading, items, emptyText = '暂无记录。' } = Astro.props;
---

<div class="related-box">
  <h2>{heading}</h2>
  {items.length > 0 ? (
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  ) : (
    <p class="card-meta">{emptyText}</p>
  )}
</div>
