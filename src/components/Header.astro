    <a class="site-header__brand" href={withBase('/')}>
      <strong>{SITE_NAME}</strong>
      <span>{SITE_TAGLINE}</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href={withBase('/products/')}>产品</a>
      <a href={withBase('/benchmarks/')}>Benchmark</a>
      <a href={withBase('/methodology/')}>测试方法</a>
      <a href={withBase('/about/')}>关于</a>
    </nav>
  </div>
</header>
