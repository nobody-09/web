---
import type { CollectionEntry } from 'astro:content';
import { resolveAttributeValue, NOT_RECORDED } from '../utils/attributes';

type MeasuredAttribute = CollectionEntry<'benchmarks'>['data']['measuredAttributes'][number];

interface Props {
  benchmark: CollectionEntry<'benchmarks'>;
  products: CollectionEntry<'products'>[];
  /** Optional explicit list of rows to render — used when a benchmark
   * page needs several separately-scoped tables (see `resultGroups` in
   * the benchmark schema). Defaults to the benchmark's flat
   * `measuredAttributes`, which is the original, still-default behavior. */
  measuredAttributes?: MeasuredAttribute[];
}

const { benchmark, products, measuredAttributes } = Astro.props;
const attributesToRender = measuredAttributes ?? benchmark.data.measuredAttributes;

const rows = attributesToRender.map((measure) => ({
  ...measure,
  cells: products.map((p) => {
    const resolved = resolveAttributeValue(p, measure.key);
    if (!resolved) return NOT_RECORDED;
    const unit = resolved.unit ?? measure.unit;
    return unit ? `${resolved.value} ${unit}` : resolved.value;
  }),
}));
---

<table>
  <thead>
    <tr>
      <th scope="col">指标</th>
      {products.map((p) => <th scope="col">{p.data.productName}</th>)}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">
          {row.label}
          {row.description ? <div class="card-meta">{row.description}</div> : null}
        </th>
        {row.cells.map((cell) => <td>{cell}</td>)}
      </tr>
    ))}
  </tbody>
</table>
