---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, withBase } from '../../utils/site';

const title = '关于';
const description = `${SITE_NAME} 是什么,以及记录如何维护。`;
---

<BaseLayout title={title} description={description} path="/about/">
  <p class="eyebrow">关于本档案</p>
  <h1>关于</h1>

  <p>
    {SITE_NAME} 是一个收录工作流软件标准化功能测试记录的档案网站。每个产品都按照
    <a href={withBase('/methodology/')}>测试方法</a>页面所述的固定流程进行测试,每个 Benchmark
    则在同一基础上比较两个或更多产品。
  </p>

  <p>
    本站不接受赞助,也不会在方法说明之外对产品进行额外的排名或评级。
  </p>
</BaseLayout>
