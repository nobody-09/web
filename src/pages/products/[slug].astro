---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttributeTable from '../../components/AttributeTable.astro';
import RelatedList from '../../components/RelatedList.astro';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();

// A product's related benchmarks are derived, not hand-maintained: any
// benchmark whose comparedProducts references this product shows up here
// automatically the moment that benchmark file is added.
//
// NOTE: `comparedProducts` entries are *unresolved* references (whatever
// raw id Astro assigned internally to each product entry, which is not
// guaranteed to be the same string as the human-readable `slug` written
// in frontmatter). Comparing `ref.id` directly against `product.slug` or
// `product.id` is fragile and silently matched nothing in practice.
// Resolving each reference with `getEntry()` — the same mechanism the
// benchmark detail page already uses for its comparison table — and then
// comparing the *resolved* entry's `.slug` is the reliable way to do this.
const allBenchmarks = await getCollection('benchmarks');
const relatedBenchmarks = [];
for (const b of allBenchmarks) {
  const comparedEntries = await Promise.all(
    b.data.comparedProducts.map((ref) => getEntry(ref))
  );
  if (comparedEntries.some((entry) => entry?.slug === product.slug)) {
    relatedBenchmarks.push(b);
  }
}

const title = product.data.productName;
const description = product.data.summary;
const path = `/products/${product.slug}/`;
---

<BaseLayout title={title} description={description} path={path} type="article">
  <p class="eyebrow">产品记录</p>
  <h1>{product.data.productName}</h1>
  <p class="meta-line">
    记录版本 {product.data.recordedVersion} &middot;
    Benchmark 版本 {product.data.benchmarkVersion} &middot;
    测试日期 {product.data.testedAt.toISOString().slice(0, 10)}
  </p>

  <AttributeTable product={product} />

  <Content />

  <RelatedList
    heading="相关 Benchmark"
    items={relatedBenchmarks.map((b) => ({
      href: withBase(`/benchmarks/${b.slug}/`),
      label: b.data.title,
    }))}
    emptyText="该产品尚未出现在已发布的 Benchmark 中。"
  />
</BaseLayout>
