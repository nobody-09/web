---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION } from '../utils/site';

const benchmarks = (await getCollection('benchmarks')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const products = await getCollection('products');
const latestBenchmarks = benchmarks.slice(0, 3);
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} path="/">
  <section class="home-hero">
    <p class="eyebrow">工作流软件测试档案</p>
    <h1>{SITE_NAME}</h1>
    <p class="lede">{SITE_TAGLINE}</p>
    <p>
      本站发布工作流软件的标准化功能测试记录,所有产品和 Benchmark 均遵循同一份
      公开的<a href="/methodology/">测试方法</a>。可以浏览完整的
      <a href="/products/">产品索引</a>,或完整的
      <a href="/benchmarks/">Benchmark 索引</a>。
    </p>
  </section>

  <section>
    <div class="home-section-heading">
      <h2>最新 Benchmark</h2>
      <a href="/benchmarks/">查看全部 Benchmark &rarr;</a>
    </div>
    <div class="card-list">
      {latestBenchmarks.map((b) => (
        <a class="card-link card" href={`/benchmarks/${b.slug}/`}>
          <div class="card-title">{b.data.title}</div>
          <p>{b.data.summary}</p>
          <div class="card-meta">
            发布日期 {b.data.publishedAt.toISOString().slice(0, 10)} &middot;
            Benchmark 版本 {b.data.benchmarkVersion}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="home-section-heading">
      <h2>涉及产品</h2>
      <a href="/products/">查看全部产品 &rarr;</a>
    </div>
    <p class="card-meta">目前已收录 {products.length} 个产品记录。</p>
  </section>
</BaseLayout>
